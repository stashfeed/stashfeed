<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app window is Stashy's canvas from the first frame, so nothing flashes white before Compose draws. -->
    <style name="Theme.StashPlayer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/stashy_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch: the Stashy mark on the canvas, then straight into the app theme. -->
    <style name="Theme.StashPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/stashy_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.StashPlayer</item>
    </style>
</resources>
